# AWS Configuration
# Replace with your desired AWS region
aws_region = "us-east-1"

# Environment and Project
environment = "dev"
project_name = "test-101"

# EC2 Instance Configuration
instance_type = "t2.micro"
instance_name = "my-instance"

# AMI - Ubuntu 22.04 LTS (update for your region if needed)
# us-east-1: ami-0c55b159cbfafe1f0
# us-west-2: ami-0efcece6bed30b129
# Replace with the correct AMI ID for your region
ami = "ami-0c55b159cbfafe1f0"

# Networking
enable_public_ip = true
# IMPORTANT: Replace with your actual public IP in CIDR format (e.g., 203.0.113.45/32)
allow_ssh_cidr = ["YOUR_PUBLIC_IP/32"]

# Tags
tags = {
  Owner      = "YOUR_NAME"
  CostCenter = "COST_CENTER"
  CreatedBy  = "Terraform"
}
